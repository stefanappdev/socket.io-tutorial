<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="/styles/signup.css" type='text/css' rel="stylesheet">
    <title>signup page</title>
</head>


<body>


<div id="signup-page">


	<form id="registration-form"> 
			<div id="registration-form-header">
					<span>Sign up to Start</span>
			</div>
						<div id='registration-form-input-section'>
							<label for='username'><strong>create a username: </strong></label>
							<input type="text" placeholder="Enter a username" name='reg_username' id="reg_username" required/>
							<br/>
							<label for='password'><strong>create a password: </strong></label>
							<input type="text" placeholder="Enter a password" name='reg_password' id="reg_password" required/>
							<br/>
						<button type='submit' id="submit-new-user-btn" name='submit-new-user-btn'>Submit</button>
							<br/>
							<a class='login-link' href='/'>Login instead?</a>
						</div>
						
		</form>

	

</div>
	
</body>

<script>
            const regForm=document.getElementById('registration-form');
		   regForm.addEventListener('submit',(event)=>{
						event.preventDefault();
						if(event.target.reg_username.value===""){
								alert("Please enter a username to register");
								return
						}
						
						if(event.target.reg_password.value===""){
								alert("Please enter a password to register");
								return
						}
						
						
						
						else{
								 let newUser={ 
											   username:event.target.reg_username.value,
											   password:event.target.reg_password.value,
										 };
						
						     if(localStorage.getItem('users')!==null){
								
								 let users= JSON.parse(localStorage.getItem('users'));
								 localStorage.setItem('users',JSON.stringify([...users,newUser]));
								 

							
							 }else{
							 
									localStorage.setItem('users',JSON.stringify( [newUser] ) );
							 
							 }
							 
								alert("Registration sucessful");
						    		event.target.reg_username.value="";
								 window.location.href="/";
								 
							
						}
		   })



</script>

</html>			