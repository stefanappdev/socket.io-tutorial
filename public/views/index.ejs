<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="/styles/index.css" type='text/css' rel="stylesheet">
    <title>Login page</title>
</head>


<body>

<div id='login-page'>

		
			<div id="login-form-background">
				<form id="login-form"> 
					<div id="login-form-header">
							<div>
								<span>Login here </span>
							</div>
					</div>
					<div id='login-form-input-section'>
									<label for='username'><strong>enter your username: </strong></label>
									<input type="text" placeholder="Enter your username" name='login_username' id="login_username" required/>
									<label for='password'><strong>enter your password: </strong></label>
									<input type="password" placeholder="Enter a password" name='login_password' id="login_password" required/>
								<br/>
								<button type='submit' id="submit-btn" name='submit-btn'>Submit</button>
								<br>
								<a class='signup-link' href='/signup'>signup instead?</a>
								
					</div>
						
				</form>
			</div>	
</div>			


<script type="text/javascript">

let isLoggedin=false;
let loginformBackground=document.getElementById('login-form-background');
let loginform=document.getElementById('login-form');

//function for login of client
function loginClient(){
		let target={
		  username:event.target.login_username.value,
		  password:event.target.login_password.value,
		  }
		  
		  //find user who is logging in
		let allUsers=JSON.parse(localStorage.getItem('allUsers'))
		let currentUsers=JSON.parse(localStorage.getItem('currentUsers'));
		let userToLogin=allUsers.find(user=>user.username===target.username&&user.password===target.password)
		
		if(userToLogin){
		   
					alert('login successful');
					isLoggedin=true;
					if(currentUsers===null){
						localStorage.setItem('currentUsers',JSON.stringify([userToLogin]))
					}else{
						localStorage.setItem('currentUsers',JSON.stringify([...currentUsers,userToLogin]))
					}
				    event.target.login_username.value='';
					event.target.login_password.value='';
					window.location.href='/chat';
					
			}else{
					alert('login unsuccessful,try again or signup to register');
					return
			}
		
	}
  
  loginform.addEventListener('submit',function(event){
		event.preventDefault();
		loginClient();
		})



</script>